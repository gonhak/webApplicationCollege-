{
  "info": {
    "_postman_id": "d50d07f7-3e9b-4eb6-aeaa-c7589ab10ce0",
    "name": "Cars API",
    "description": "Cars API: CRUD cars, Identity accounts, JWT and role-based authorization.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Cars",
      "item": [
        {
          "name": "GET All Cars",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cars"
              ]
            }
          }
        },
        {
          "name": "GET Car By Id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cars/{{carId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cars",
                "{{carId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication and authorization",
      "description": "Use Mailtrap Email Sandbox for confirmation/reset links. The account and token variables below are local test values.",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/account/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "account",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"student1\",\n  \"email\": \"student1@test.pl\",\n  \"password\": \"Student123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Creates a User and sends the confirmation link to Mailtrap."
          },
          "response": []
        },
        {
          "name": "Confirm Email",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/account/confirm-email?userId={{userId}}&token={{confirmationToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "account",
                "confirm-email"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}",
                  "disabled": false
                },
                {
                  "key": "token",
                  "value": "{{confirmationToken}}",
                  "disabled": false
                }
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Copy userId and the token from the email, then set the corresponding collection variables."
          },
          "response": []
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/account/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "account",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student1@test.pl\",\n  \"password\": \"Student123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('userToken', pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Cars without token (expect 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cars"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "GET Cars as User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cars",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cars"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "DELETE Car as User (expect 403)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cars/{{carId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cars",
                "{{carId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/account/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "account",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cars.local\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('adminToken', pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE Car as Admin (expect 204)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cars/{{carId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cars",
                "{{carId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/account/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "account",
                "forgot-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student1@test.pl\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Check Mailtrap for a reset link."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/account/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "account",
                "reset-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{resetEmail}}\",\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"NoweHaslo123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Set resetEmail and resetToken from the Mailtrap reset link."
          },
          "response": []
        }
      ]
    }
  ],
